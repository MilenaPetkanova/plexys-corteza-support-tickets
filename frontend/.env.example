# Corteza dedicated Auth Client (System > Auth clients in Corteza Admin)
# Grant type: authorization_code. See docs/ for setup steps.
VITE_AUTH_CLIENT_ID=
VITE_AUTH_CLIENT_SECRET=
VITE_AUTH_REDIRECT_URI=http://localhost:5173/callback

# Relative paths proxied to the Corteza server by vite.config.ts in dev
# (keeps the SPA, API and auth server same-origin; avoids CORS)
VITE_AUTH_BASE_URL=/auth
VITE_API_BASE_URL=/api

# PrimeVue 5 ("PrimeUI") Community license key - free tier, tied to your own
# PrimeTek account (individuals/small orgs/OSS all qualify). Get one at
# https://primeui.dev/licenses/community - reviewers need their own key too.
VITE_PRIMEVUE_LICENSE_KEY=
